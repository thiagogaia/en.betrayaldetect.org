# EDGE_CACHE_V13 - Aggressive caching para assets, curto para HTML.
# Compatível com Apache/cPanel + Cloudflare (que respeita Cache-Control quando habilitado).

# ===== Compression =====
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/x-javascript application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 font/ttf font/otf
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff font/woff2
</IfModule>

# ===== MIME types =====
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# ===== Expires (long for assets, short for HTML) =====
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: short cache, validate often (5 min browser, 1 hour edge)
    ExpiresByType text/html "access plus 5 minutes"

    # Images: 30 days
    ExpiresByType image/jpeg     "access plus 30 days"
    ExpiresByType image/png      "access plus 30 days"
    ExpiresByType image/webp     "access plus 30 days"
    ExpiresByType image/avif     "access plus 30 days"
    ExpiresByType image/gif      "access plus 30 days"
    ExpiresByType image/svg+xml  "access plus 30 days"
    ExpiresByType image/x-icon   "access plus 30 days"

    # CSS / JS: 7 days (fingerprint via query string when needed)
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType text/javascript         "access plus 7 days"

    # Fonts: 1 year (immutable)
    ExpiresByType font/woff2  "access plus 1 year"
    ExpiresByType font/woff   "access plus 1 year"
    ExpiresByType font/ttf    "access plus 1 year"
    ExpiresByType font/otf    "access plus 1 year"
</IfModule>

# ===== Cache-Control headers (overrides for edge / Cloudflare) =====
<IfModule mod_headers.c>
    # HTML: short browser cache, longer edge cache, allow revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
    </FilesMatch>

    # Images: long cache, immutable
    <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000, s-maxage=2592000, immutable"
        Header set Vary "Accept"
    </FilesMatch>

    # CSS/JS: medium cache
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800, s-maxage=604800"
    </FilesMatch>

    # Fonts: 1 year immutable
    <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Security
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ===== Disable ETag (use Last-Modified instead - works better with CDN) =====
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# ===== Force HTTPS =====
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
